# TeaFlow Frontend Environment Variables
# Copy this file to .env and fill in your values

# Frontend URL (for QR code generation and links)
VITE_FRONTEND_URL=https://order-manager-team.vercel.app

# Backend API URL
VITE_API_URL=https://ordermanager-u5vu.onrender.com

# Supabase Configuration
# Get these from your Supabase project dashboard (Settings > API)
# NOTE: These are only needed if the frontend ever queries Supabase directly.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Razorpay (TEST MODE - public key only, NEVER put secret here)
# Get from https://dashboard.razorpay.com/app/keys (TEST Key ID)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id