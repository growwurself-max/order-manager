# ===========================
# TeaFlow Backend Configuration
# ===========================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for QR code generation and customer URLs)
FRONTEND_URL=https://order-manager-team.vercel.app

# JWT Secrets
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRY=8h

# Supabase
# Get these from your Supabase project dashboard (Settings > API)
SUPABASE_URL=https://wmsvdlkqkhvdzhqdytgy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# CORS
# Comma-separated list of allowed origins (no trailing spaces)
# Production-only configuration
CORS_ORIGIN=https://order-manager-team.vercel.app

# Rate Limiting (optional overrides)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=500

# Cloudinary (required for product image uploads)
# Get these from your Cloudinary dashboard (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=nq1wccuh
CLOUDINARY_API_KEY=322215733584696
CLOUDINARY_API_SECRET=x3pKi5mc1VGaVqWxmt_Zq5k0D4U
